    {
      "name": "03. Subscription Plans",
      "item": [
        {
          "name": "GET List Plans (/api/platform/plans)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var plans = pm.response.json();",
                  "if (Array.isArray(plans) && plans.length > 0) {",
                  "    pm.environment.set('planId', plans[0].planId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/platform/plans", "host": ["{{baseUrl}}"], "path": ["api", "platform", "plans"] }
          }
        },
        {
          "name": "POST Create Custom Plan (/api/platform/plans)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planName\": \"custom plan {{$timestamp}}\",\n  \"pricingType\": \"PER_MODULE\",\n  \"priceAmount\": 499,\n  \"currencyCode\": \"INR\",\n  \"userLimit\": 100,\n  \"storageLimitGb\": 5,\n  \"smsLimit\": 5000,\n  \"apiLimit\": 10000,\n  \"maxInstitutions\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/platform/plans", "host": ["{{baseUrl}}"], "path": ["api", "platform", "plans"] }
          }
        }
      ]
    },
    {
      "name": "04. Tenants Directory & Lifecycle",
      "item": [
        {
          "name": "GET Tenants Directory (/api/platform/tenants)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var data = pm.response.json();",
                  "if (data.items && data.items.length > 0) {",
                  "    pm.environment.set('tenantId', data.items[0].tenantId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/platform/tenants?page=0&size=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "platform", "tenants"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "50" }
              ]
            }
          }
        },
        {
          "name": "POST Create Tenant (Trial Mode)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantName\": \"manoj test123 institution\",\n  \"tenantType\": \"STANDALONE_SCHOOL\",\n  \"planId\": \"{{planId}}\",\n  \"subdomain\": \"manoj-test-{{$randomInt}}\",\n  \"isolationMode\": \"SHARED\",\n  \"firstAdminName\": \"Manoj gowda.N\",\n  \"firstAdminEmail\": \"nmanojgowda47@gmail.com\",\n  \"firstAdminMobile\": \"+919341116915\",\n  \"firstAdminNationalIdLast4\": \"8956\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/platform/tenants", "host": ["{{baseUrl}}"], "path": ["api", "platform", "tenants"] }
          }
        },
        {
          "name": "GET Tenant Settings (/api/platform/tenants/:id/settings)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/platform/tenants/{{tenantId}}/settings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "platform", "tenants", "{{tenantId}}", "settings"]
            }
          }
        },
        {
          "name": "PATCH Tenant Settings (/api/platform/tenants/:id/settings)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"timeZone\": \"Asia/Kolkata\",\n  \"dataRegion\": \"IN\",\n  \"analyticsOptOut\": false,\n  \"customDomain\": \"sound-{{$randomInt}}.edu360.local\",\n  \"userLimit\": 1000,\n  \"storageLimitGb\": 10\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/platform/tenants/{{tenantId}}/settings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "platform", "tenants", "{{tenantId}}", "settings"]
            }
          }
        }
      ]
    },
