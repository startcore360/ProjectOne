{
  "info": {
    "_postman_id": "edu360-platform-v1",
    "name": "EDU 360 – Platform & Tenant Core API Suite",
    "description": "Comprehensive API collection for EDU 360 Sprint 1 verification covering Platform Owner authentication, multi-tenant governance, subscription plans, tenant provisioning, audit logs, and operational controls.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.request.headers.has('X-Correlation-ID')) {",
          "    pm.request.headers.add({",
          "        key: 'X-Correlation-ID',",
          "        value: 'pm-' + Date.now() + '-' + Math.random().toString(36).substring(2, 7)",
          "    });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01. Authentication & Identity",
      "item": [
        {
          "name": "POST Login (Platform Owner)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var data = pm.response.json();",
                  "if (data.accessToken) {",
                  "    pm.environment.set('token', data.accessToken);",
                  "    console.log('JWT access token updated in environment');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{ownerEmail}}\",\n  \"password\": \"{{ownerPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "GET Current User Profile (/api/auth/me)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        },
        {
          "name": "POST Logout (/api/auth/logout)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] }
          }
        }
      ]
    },
