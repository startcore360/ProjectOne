# VITE_API_BASE_URL is intentionally left unset in local dev: axios.ts derives it from
# whatever hostname the page was loaded from (abc.edu360.local / xyz.edu360.local /
# platform.edu360.local), since the backend tells tenants apart by that Host header. Set this
# only to override that behavior (e.g. pointing at a different host/port entirely).
# VITE_API_BASE_URL=http://localhost:8080/api
