# NGINX_ENVSUBST_FILTER in compose limits substitution to EDU360_DOMAIN only;
# nginx runtime variables such as $host and $scheme remain intact.
server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    server_name ~^(?<tenant>[a-z0-9][a-z0-9-]*)\.${EDU360_DOMAIN}$;
    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl default_server;
    server_name _;
    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    return 444;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ~^(?<tenant>[a-z0-9][a-z0-9-]*)\.${EDU360_DOMAIN}$;

    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:EDU360_TLS:10m;
    ssl_session_tickets off;

    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    client_max_body_size 11m;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;

    # API documentation and developer consoles are never public in production.
    location ~* ^/(swagger-ui|v3/api-docs|h2-console)(/|$) {
        return 404;
    }

    location ~ ^/(api|v1)(/|$) {
        proxy_pass http://edu360-api:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
