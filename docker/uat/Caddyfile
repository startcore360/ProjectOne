# EDU 360 UAT/test-server ingress. Replace the DuckDNS names below with the
# exact hostnames provisioned for this server before starting Caddy.
{
    email {$ACME_EMAIL}
}

{$PLATFORM_HOSTNAME}, {$TENANT_HOSTNAMES} {
    encode zstd gzip

    @api path /api/*
    handle @api {
        reverse_proxy 127.0.0.1:8080
    }

    handle {
        root * /srv/edu360/dist
        try_files {path} /index.html
        file_server
    }
}
